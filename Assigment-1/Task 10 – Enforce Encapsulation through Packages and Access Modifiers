
import java.util.Scanner;

// Model class
class ParkingSlot {
    private int slotNumber;
    private boolean occupied;

    public ParkingSlot(int slotNumber) {
        setSlotNumber(slotNumber);
        this.occupied = false;
    }

    public int getSlotNumber() {
        return slotNumber;
    }

    public void setSlotNumber(int slotNumber) {
        if (slotNumber > 0) {
            this.slotNumber = slotNumber;
        } else {
            throw new IllegalArgumentException(
                "Slot number must be positive"
            );
        }
    }

    public boolean isOccupied() {
        return occupied;
    }

    public void setOccupied(boolean occupied) {
        this.occupied = occupied;
    }
}

// Service class
class ParkingService {
    private Integer parkingDuration;

    public void setParkingDuration(Integer parkingDuration) {
        if (parkingDuration == null || parkingDuration <= 0) {
            throw new IllegalArgumentException(
                "Parking duration must be positive"
            );
        }

        this.parkingDuration = parkingDuration;
    }

    public Integer getParkingDuration() {
        return parkingDuration;
    }

    public double calculateFee() {
        return parkingDuration * 30.0;
    }
}

// Main application class
public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        try {
            System.out.println("PARKING MANAGEMENT SYSTEM");

            System.out.print("Enter Parking Slot Number: ");
            int slotNo = sc.nextInt();

            ParkingSlot slot = new ParkingSlot(slotNo);

            System.out.print("Enter Parking Duration (hours): ");
            int duration = sc.nextInt();

            ParkingService service = new ParkingService();
            service.setParkingDuration(duration);

            System.out.println("\nPARKING DETAILS");
            System.out.println("Slot Number: " +
                slot.getSlotNumber());

            System.out.println("Slot Occupied: " +
                slot.isOccupied());

            slot.setOccupied(true);

            System.out.println("Updated Occupancy: " +
                slot.isOccupied());

            System.out.println("Parking Duration: " +
                service.getParkingDuration() + " hours");

            System.out.println("Total Parking Fee: Rs " +
                service.calculateFee());

        } catch (IllegalArgumentException e) {
            System.out.println("Invalid Input: " + e.getMessage());
        }

        sc.close();
    }
}
